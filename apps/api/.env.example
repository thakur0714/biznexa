# ── Core ──
NODE_ENV=development
PORT=4000
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=postgresql://biznexa:biznexa@localhost:5432/biznexa?schema=public

# ── Auth ── (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
OTP_PEPPER=change-me-otp-pepper
GOOGLE_CLIENT_ID=

# ── Certificates ── secret used to sign QR verification links
CERT_QR_SECRET=change-me-qr-secret

# ── Files ── private uploads (D17). UPLOAD_DIR must not be publicly served; in production a
# persistent volume shared by every API instance. FILE_LINK_SECRET signs 5-minute download links.
FILE_LINK_SECRET=change-me-file-link-secret
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=25
# Public website images (M9.4): served at /api/media with a 1-year cache. Separate from UPLOAD_DIR.
MEDIA_DIR=media
# Virus scan after upload: stub (flags only the EICAR test file; dev/test) or clamav (clamd INSTREAM).
# Development uses stub (no ClamAV needed). Production: clamd with StreamMaxLength >= UPLOAD_MAX_MB.
VIRUS_SCANNER=stub
# PDFs (invoices, certificates; M3.22): playwright = headless Chromium (install it once with
# `pnpm --filter @biznexa/api exec playwright-core install chromium --only-shell`); stub = plain-text PDFs, not for production.
PDF_RENDERER=playwright
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ── Encryption at rest ── staff 2FA secrets (and PAN later). Never change it once data exists.
DATA_ENCRYPTION_KEY=change-me-data-encryption-key

# ── Providers ── (console = log to terminal in development)
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Delivery reports (M6.3): report URL https://<api>/api/notifications/callbacks/msg91?token=<this>. Empty = off.
MSG91_WEBHOOK_TOKEN=
EMAIL_PROVIDER=smtp
EMAIL_FROM=BizNexa <no-reply@biznexa.com>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SENDGRID_API_KEY=
# Signed Event Webhook (M6.3) → https://<api>/api/notifications/callbacks/sendgrid. Empty = off.
SENDGRID_WEBHOOK_PUBLIC_KEY=
FCM_PROVIDER=fake
FIREBASE_PROJECT_ID=
# Service account JSON (one line) from Firebase console → Project settings → Service accounts
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Payments ── (D42) mock = in-memory gateway for dev/test (refused in production); razorpay needs
# the key id/secret (Dashboard → API Keys; rzp_test_… for test mode) and the webhook secret you set
# on the webhook in Dashboard → Webhooks.
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Company (seller details for GST invoices) ──
COMPANY_STATE_CODE=PB

# Queues (BullMQ). Tests use QUEUE_PREFIX=bn-test (see test/setup-env.js).
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=bn
