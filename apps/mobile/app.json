        "backgroundColor": "#1f2b7a"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "extra": {
      "platformTarget": "android-tester-apk",
      "decisionDate": "2026-10-18",
      "distribution": "internal-testers-only",
      "noIos": true,
      "noStore": true
    }
  }
}
