{
  "name": "biznexa",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @biznexa/api prisma:migrate",
    "db:seed": "pnpm --filter @biznexa/api prisma:seed",
    "db:reset": "pnpm --filter @biznexa/api prisma:reset"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild", "sharp", "@nestjs/core", "unrs-resolver"]
  }
}
